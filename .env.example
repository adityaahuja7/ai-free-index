# --- AI Free Software Index ---
# Copy to .env and fill in what you have. Everything here is optional: the
# pipeline runs with no configuration and degrades gracefully.

# Google AI Studio (Gemini) free-tier key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: several free keys, comma separated, rotated when one hits quota.
GEMINI_API_KEYS=

# Optional: override the enrichment model (free-tier models only).
GEMINI_MODEL=gemini-2.5-flash

# Optional: raises GitHub search rate limit from 10 to 30 requests/minute.
# In GitHub Actions use ${{ secrets.GITHUB_TOKEN }} instead.
GITHUB_TOKEN=

# Optional path overrides (defaults: ./data and ./_site)
# AIINDEX_DATA_DIR=
# AIINDEX_SITE_DIR=
